{
	"name": "@bear-harness/web-dev",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "node scripts/build.mjs",
		"typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
		"test:unit": "node --test server/data-directory.spec.ts server/codex-session-credential.spec.ts server/soak-metrics.spec.ts e2e/bounded-trace.test.ts scripts/proxy-failure.test.mjs scripts/proxy-transport.test.mjs scripts/web-launch-mode.test.mjs",
		"test:e2e": "playwright test",
		"test:e2e:required": "node scripts/test-required.mjs",
		"test:e2e:live": "node ../../scripts/require-live-model-env.mjs && playwright test live-model.spec.ts",
		"test:e2e:soak": "node ../../scripts/require-soak-env.mjs && npm run build && playwright test soak-acceptance.spec.ts"
	},
	"dependencies": {
		"@bear-harness/companion-client": "file:../../packages/companion-client",
		"@bear-harness/companion-ui": "file:../../packages/companion-ui",
		"@bear-harness/host-runtime": "file:../../packages/host-runtime",
		"@bear-harness/i18n": "file:../../packages/i18n",
		"@bear-harness/product-config": "file:../../packages/product-config",
		"@bear-harness/protocol": "file:../../packages/protocol",
		"@kobalte/core": "0.13.14",
		"@tanstack/solid-query": "5.104.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@rsbuild/core": "2.2.12",
		"@rsbuild/plugin-babel": "2.1.0",
		"@rsbuild/plugin-solid": "1.2.2",
		"@rsbuild/plugin-tailwindcss": "2.0.3",
		"@types/node": "26.6.4",
		"fflate": "0.8.3",
		"playwright": "1.64.0",
		"solid-js": "1.9.17",
		"typescript": "7.0.2"
	}
}
