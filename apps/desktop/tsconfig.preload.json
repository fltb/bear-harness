{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "src/preload",
		"outDir": "dist/preload",
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"sourceMap": false,
		"declaration": false,
		"types": ["node"]
	},
	"include": ["src/preload/**/*.cts"]
}
