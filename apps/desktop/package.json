{
	"name": "@bear-harness/desktop",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "dist/main/index.js",
	"description": "Cyber Bear desktop app — SolidJS renderer on an Electron shell.",
	"author": "fltb",
	"scripts": {
		"lint": "node scripts/validate-product-config.mjs && node scripts/check-diagnostics-contracts.mjs",
		"typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
		"dev": "node scripts/dev.mjs",
		"build": "node scripts/build.mjs",
		"test:unit": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:packaged": "node scripts/resolve-packaged-binary.mjs",
		"test:diagnostics:crash": "node scripts/crash-smoke.mjs",
		"package:mac": "node scripts/validate-product-config.mjs && electron-builder --config electron-builder.config.ts --mac dmg zip --universal",
		"package:win": "node scripts/validate-product-config.mjs && electron-builder --config electron-builder.config.ts --win nsis zip --x64",
		"package:linux": "node scripts/validate-product-config.mjs && electron-builder --config electron-builder.config.ts --linux AppImage deb --x64"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@kobalte/core": "0.13.13",
		"csv-parse": "7.0.2",
		"csv-stringify": "6.8.3",
		"docx": "9.7.1",
		"exifr": "7.1.3",
		"fast-xml-parser": "5.10.1",
		"file-type": "22.0.1",
		"image-size": "2.0.2",
		"jszip": "3.10.1",
		"mammoth": "1.12.1",
		"pdf-lib": "1.17.1",
		"pdfjs-dist": "6.2.108",
		"pptxgenjs": "4.0.1",
		"remark-gfm": "4.0.1",
		"solid-markdown": "2.1.1",
		"typebox": "1.3.13",
		"xlsx": "file:vendor/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@rsbuild/core": "2.1.11",
		"@rsbuild/plugin-babel": "2.0.1",
		"@rsbuild/plugin-solid": "1.2.2",
		"@rsbuild/plugin-tailwindcss": "2.0.3",
		"@solidjs/testing-library": "0.8.10",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/user-event": "14.6.4",
		"@types/node": "24.13.3",
		"@vitest/coverage-v8": "4.1.10",
		"electron": "43.4.0",
		"electron-builder": "26.15.3",
		"esbuild": "0.28.2",
		"jsdom": "30.0.1",
		"playwright": "1.62.1",
		"solid-js": "1.9.14",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vite-plugin-solid": "2.11.14",
		"vitest": "4.1.10"
	}
}
