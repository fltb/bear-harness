{
	"name": "@bear-harness/i18n",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./locales": {
			"types": "./dist/locales/index.d.ts",
			"import": "./dist/locales/index.js"
		}
	},
	"scripts": {
		"build": "node scripts/generate-zh-tw.mjs && tsc -p tsconfig.json",
		"generate:locales": "node scripts/generate-zh-tw.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test:unit": "vitest run"
	},
	"dependencies": {
		"i18next": "26.4.3",
		"solid-i18next": "0.0.5",
		"solid-js": "1.9.17"
	},
	"devDependencies": {
		"opencc-js": "1.4.2",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	}
}
