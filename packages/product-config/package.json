{
	"name": "@bear-harness/product-config",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./locales": {
			"types": "./dist/locales.d.ts",
			"import": "./dist/locales.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/generate-zh-tw.mjs && tsc -p tsconfig.json",
		"generate:locales": "node scripts/generate-zh-tw.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"opencc-js": "1.4.1",
		"typescript": "7.0.2"
	}
}
