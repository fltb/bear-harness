{
	"name": "@bear-harness/host-runtime",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"prebuild": "node ../../scripts/build-workspaces.mjs tdai-core protocol",
		"build": "tsc -p tsconfig.json && node scripts/check-esm-runtime.mjs",
		"db:generate": "drizzle-kit generate",
		"pretypecheck": "node ../../scripts/build-workspaces.mjs tdai-core protocol",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test:unit": "node ../../scripts/build-workspaces.mjs tdai-core protocol && vitest run",
		"test:release:recovery": "node ../../scripts/build-workspaces.mjs tdai-core protocol && vitest run tests/bootstrap-recovery.spec.ts tests/durable-file-transaction.spec.ts tests/character-import.spec.ts tests/companion-state-store.spec.ts tests/session-catalog.spec.ts",
		"test:coverage": "node ../../scripts/build-workspaces.mjs tdai-core protocol && vitest run --coverage"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "1.7.0",
		"@bear-harness/protocol": "file:../protocol",
		"@bear-harness/schema": "file:../schema",
		"@bear-harness/tdai-core": "file:../tdai-core",
		"@earendil-works/pi-agent-core": "1.1.0",
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"ajv": "8.20.0",
		"drizzle-orm": "^1.0.0-rc.4",
		"fast-json-patch": "3.1.1",
		"officeparser": "8.1.1",
		"p-queue": "9.3.3",
		"proper-lockfile": "4.1.2",
		"sqlite-vec": "0.1.9",
		"undici": "8.11.2",
		"yaml": "2.9.1",
		"yauzl": "3.4.0",
		"@agentclientprotocol/codex-acp": "2.1.1",
		"fflate": "0.8.3"
	},
	"devDependencies": {
		"@types/node": "26.6.4",
		"@types/proper-lockfile": "4.1.4",
		"@types/yauzl": "3.4.0",
		"@vitest/coverage-v8": "5.0.3",
		"drizzle-kit": "^1.0.0-rc.4",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	}
}
