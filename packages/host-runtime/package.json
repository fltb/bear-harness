		"image-size": "2.0.2",
		"jszip": "3.10.1",
		"mammoth": "1.12.1",
		"pdf-lib": "1.17.1",
		"pdfjs-dist": "6.2.108",
		"pptxgenjs": "4.0.1",
		"typebox": "1.3.13",
