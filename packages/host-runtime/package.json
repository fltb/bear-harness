{
	"name": "@bear-harness/host-runtime",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"prebuild": "npm --prefix ../tdai-core run build && npm --prefix ../protocol run build",
		"build": "tsc -p tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"pretypecheck": "npm --prefix ../tdai-core run build && npm --prefix ../protocol run build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test:unit": "npm --prefix ../tdai-core run build && npm --prefix ../protocol run build && vitest run",
		"test:coverage": "npm --prefix ../tdai-core run build && npm --prefix ../protocol run build && vitest run --coverage"
	},
	"dependencies": {
		"@agentclientprotocol/codex-acp": "^1.2.0",
		"@agentclientprotocol/sdk": "^1.3.0",
		"@bear-harness/protocol": "file:../protocol",
		"@bear-harness/schema": "file:../schema",
		"@bear-harness/tdai-core": "file:../tdai-core",
		"@earendil-works/pi-agent-core": "^0.84.1",
		"@earendil-works/pi-ai": "^0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@office-kit/pptx": "^0.12.0",
		"csv-parse": "7.0.2",
		"docx": "9.7.1",
		"drizzle-orm": "^1.0.0-rc.4",
		"exifr": "7.1.3",
		"fast-xml-parser": "5.10.1",
		"file-type": "22.0.1",
		"image-dimensions": "^2.5.1",
		"jszip": "3.10.1",
		"mammoth": "1.12.1",
		"node-llama-cpp": "3.16.2",
		"pdf-lib": "1.17.1",
		"pdfjs-dist": "6.2.108",
		"xlsx": "file:../../apps/desktop/vendor/xlsx-0.20.3.tgz",
		"yaml": "2.9.0",
		"undici": "^7.0.0"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"@vitest/coverage-v8": "4.1.10",
		"drizzle-kit": "^1.0.0-rc.4",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
