{
	"name": "@bear-harness/companion-ui",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./layout": {
			"types": "./src/layout.ts",
			"import": "./src/layout.ts"
		},
		"./styles.css": {
			"types": "./src/styles.d.ts",
			"default": "./src/styles.css"
		}
	},
	"scripts": {
		"prebuild": "node ../../scripts/build-workspaces.mjs product-config i18n protocol companion-client",
		"build": "tsc -p tsconfig.json --noEmit",
		"pretypecheck": "node ../../scripts/build-workspaces.mjs product-config i18n protocol companion-client",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test:unit": "node ../../scripts/build-workspaces.mjs product-config i18n protocol companion-client && vitest run",
		"test:coverage": "node ../../scripts/build-workspaces.mjs product-config i18n protocol companion-client && BEAR_COVERAGE=1 vitest run --coverage"
	},
	"dependencies": {
		"@bear-harness/companion-client": "file:../companion-client",
		"@bear-harness/i18n": "file:../i18n",
		"@bear-harness/product-config": "file:../product-config",
		"@bear-harness/protocol": "file:../protocol",
		"@fortawesome/free-solid-svg-icons": "7.3.1",
		"@jsonforms/core": "3.8.0",
		"@kobalte/core": "0.13.14",
		"@tanstack/solid-query": "5.104.1",
		"@tanstack/solid-virtual": "3.13.40",
		"dompurify": "3.4.16",
		"highlight.js": "11.12.0",
		"i18next": "26.4.2",
		"katex": "0.18.5",
		"marked": "18.1.0",
		"marked-highlight": "2.2.4",
		"marked-katex-extension": "5.1.13",
		"solid-js": "1.9.17",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@solidjs/testing-library": "0.8.10",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/user-event": "14.6.7",
		"@vitest/coverage-v8": "5.0.3",
		"fflate": "0.8.3",
		"jsdom": "30.1.2",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.3",
		"vite-plugin-solid": "2.11.14",
		"vitest": "5.0.3"
	}
}
