{
	"name": "@bear-harness/companion-ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./styles.css": {
			"types": "./src/styles.d.ts",
			"default": "./src/styles.css"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json --noEmit",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test:unit": "npm --prefix ../product-config run build && npm --prefix ../i18n run build && npm --prefix ../protocol run build && npm --prefix ../companion-client run build && vitest run",
		"test:coverage": "npm --prefix ../product-config run build && npm --prefix ../i18n run build && npm --prefix ../protocol run build && npm --prefix ../companion-client run build && vitest run --coverage"
	},
	"dependencies": {
		"@bear-harness/companion-client": "file:../companion-client",
		"@bear-harness/i18n": "file:../i18n",
		"@bear-harness/product-config": "file:../product-config",
		"@bear-harness/protocol": "file:../protocol",
		"@fortawesome/free-solid-svg-icons": "7.3.1",
		"@kobalte/core": "0.13.13",
		"@tanstack/solid-query": "^5.101.4",
		"solid-js": "1.9.14"
	},
	"devDependencies": {
		"@solidjs/testing-library": "0.8.10",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/user-event": "14.6.4",
		"@vitest/coverage-v8": "4.1.10",
		"jsdom": "30.0.1",
		"tailwindcss": "^4.3.3",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vite-plugin-solid": "2.11.14",
		"vitest": "4.1.10"
	}
}
