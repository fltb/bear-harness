# Optional live-model WebDev smoke test.
# Copy to .env, choose exact ids returned by provider.list:v1, then run:
# npm run test:e2e:web
BEAR_E2E_LIVE_MODEL=0
BEAR_E2E_PROVIDER_ID=openai
BEAR_E2E_MODEL_ID=gpt-5-mini
BEAR_E2E_API_KEY=
# Set for an OpenAI-compatible custom endpoint; omit for a built-in provider.
# BEAR_E2E_CUSTOM_BASE_URL=http://127.0.0.1:11434/v1

# Override a built-in Provider endpoint while retaining all of its preset models.
# BEAR_PROVIDER_OVERRIDE_ID=openai
# BEAR_PROVIDER_OVERRIDE_BASE_URL=https://relay.example.com/v1

# Configure Provider credentials independently from its endpoint.
# BEAR_PROVIDER_CREDENTIAL_ID=openai
# BEAR_PROVIDER_API_KEY=provider-api-key

# Register a genuinely new OpenAI-compatible Provider with a custom model.
# BEAR_CUSTOM_PROVIDER_ID=local-openai
# BEAR_CUSTOM_PROVIDER_NAME=Local OpenAI-compatible
# BEAR_CUSTOM_BASE_URL=http://127.0.0.1:11434/v1
# BEAR_CUSTOM_MODEL_ID=qwen2.5:7b
# BEAR_CUSTOM_API_KEY=local-development-key

# Optional WebDev runtime overrides.
BEAR_WEB_DEV_HOST_PORT=3201
# Browser UI port. Development scans upward automatically if either default is occupied.
BEAR_WEB_DEV_PORT=3200
BEAR_WEB_DEV_DEBUG=1
# BEAR_WEB_DEV_DATA_DIR=/absolute/path/to/disposable/dev-data
# BEAR_WEB_DEV_MASTER_KEY=64-hex-characters
